{
  "rootDir": ".",
  "coverageDirectory": "<rootDir>/tests/__coverage__/",
  "setupFilesAfterEnv": ["<rootDir>/jest/ts.testSetup.js"],
  "setupFiles": ["<rootDir>/jest/__mocks__/shim.js"],
  "roots": ["<rootDir>/tests/"],
  "moduleNameMapper": {
    "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$":
      "<rootDir>/jest/__mocks__/fileMock.js",
    "\\.(css|scss|less)$": "<rootDir>/jest/__mocks__/styleMock.js"
  },
  "moduleFileExtensions": ["js", "jsx", "ts", "tsx"],
  "transform": {
    "^.+\\.(js|jsx|ts|tsx)$": ["@swc/jest"]
  },
  "transformIgnorePatterns": ["/node_modules/"],
  "testRegex": "/tests/.*\\.spec\\.(js|jsx|ts|tsx)$",
  "moduleDirectories": ["node_modules"],
  "globals": {
    "DEVELOPMENT": false,
    "FAKE_SERVER": false
  },
  "bail": true,
  "verbose": true,
  "testEnvironment": "node",
  "reporters": [
    "default",
    [
      "./node_modules/jest-html-reporter",
      {
        "pageTitle": "Test Report",
        "outputPath": "./tests/__reports__/report.html"
      }
    ]
  ]
}
